{
  "name": "poststage",
  "version": "0.1.0",
  "description": "Local canvas to ideate, preview and judge social posts",
  "type": "module",
  "scripts": {
    "start": "node build/scripts/launcher.js",
    "dev": "node build/scripts/launcher.js --dev",
    "build": "node build/scripts/build-web.js",
    "verify": "node scripts/verify-workspace.mjs",
    "test:store": "node tests/store.test.mjs",
    "test:score": "node tests/score-parity.test.mjs",
    "test:export": "node tests/export.test.mjs",
    "test:undo": "node tests/undo.test.mjs",
    "test:paste": "node tests/paste-snapshot.test.mjs",
    "test:browser": "node tests/browser-copy-outcome.mjs",
    "test:browser-thread": "node tests/browser-thread-outcome.mjs",
    "test:browser-reload": "node tests/browser-outcome-reload.mjs",
    "test:browser-posts": "node tests/browser-post-isolation.mjs",
    "test:browser-media": "node tests/browser-media-reload.mjs",
    "test:browser-media-session": "node tests/browser-media-session.mjs",
    "test:browser-compress": "node tests/browser-compress.mjs",
    "test:browser-platform": "node tests/browser-platform-paste.mjs",
    "test:browser-board": "node tests/browser-board-copied.mjs",
    "test:browser-noted": "node tests/browser-board-noted.mjs",
    "test:browser-copyout": "node tests/browser-copy-out.mjs",
    "test:browser-board-list": "node tests/browser-board-list.mjs",
    "test:browser-video-slot": "node tests/browser-video-slot.mjs",
    "test:browser-video-link": "node tests/browser-video-link.mjs",
    "test:browser-video-x": "node tests/browser-video-x.mjs",
    "test:video-link": "node tests/video-link.test.mjs",
    "test:ledger": "node tests/ledger.test.mjs",
    "test:inbox-still": "node tests/inbox-still.test.mjs",
    "score": "cargo build --release --manifest-path build/score/Cargo.toml"
  },
  "dependencies": {},
  "devDependencies": {
    "playwright": "^1.52.0"
  }
}
